# FarmPath / AgriNova — Environment Variable Reference
#
# This file is the central reference for the environment variables used by
# the frontend and the main platform backend.
#
# IMPORTANT:
# Do NOT copy this entire file into one .env file.
# The frontend and backend must each have their own environment file.
#
# 1. Frontend:
#    Copy the FRONTEND section into a file named `.env.local` in the
#    repository root (the same directory as the root package.json).
#
# 2. Main backend:
#    Copy the MAIN BACKEND section into `AgriNova-Server/.env`.
#    Use `AgriNova-Server/.env.example` as the service-specific reference
#    if it exists, and keep the actual secrets only in the untracked .env.
#
# 3. Python AI microservice:
#    Its environment is managed separately. See
#    `AgriNova-AI/ai-service/.env.example` and create
#    `AgriNova-AI/ai-service/.env` only if local overrides are required.
#
# Never commit .env, .env.local, or any file containing real credentials.
# Values below are placeholders; replace them with your own local values.

###############################################################################
# FRONTEND — copy this section to ROOT/.env.local
###############################################################################

# Main platform backend API base URL.
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Production example:
# NEXT_PUBLIC_API_URL=https://agrinova-backend1.onrender.com/api

# Firebase Web App configuration.
# These are browser-facing Firebase project configuration values.
# Obtain them from Firebase Console > Project settings > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Stripe publishable key (safe for browser use; never put a Stripe secret key here).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=


###############################################################################
# MAIN PLATFORM BACKEND — copy this section to AgriNova-Server/.env
###############################################################################

PORT=5000
NODE_ENV=development

# MongoDB connection string.
# Local example:
MONGODB_URI=mongodb://127.0.0.1:27017/agrinova
# For MongoDB Atlas, replace this with your Atlas connection string.

# JWT authentication.
# Generate a long, random, unique value for JWT_SECRET.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=30d

# Frontend origin allowed by the backend's CORS configuration.
FRONTEND_URL=http://localhost:3000

# Optional external service configuration.
# Leave blank if the corresponding integration is not configured.
WEATHER_API_KEY=
PAYMENT_GATEWAY_KEY=
AI_API_KEY=
CLOUD_STORAGE_BUCKET=

# Cloudinary image storage.
# Configure all required Cloudinary values when using Cloudinary uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Python FastAPI AI microservice base URL.
# Local development:
AI_SERVICE_URL=http://127.0.0.1:8000
# Production example:
# AI_SERVICE_URL=https://agrinova-ai-service.onrender.com


###############################################################################
# DEPLOYMENT NOTES
###############################################################################
#
# For the currently deployed FarmPath environment, configure variables in
# the hosting providers' project/service settings (not in committed files).
#
# Frontend (Vercel):
#   NEXT_PUBLIC_API_URL=https://agrinova-backend1.onrender.com/api
#
# Main backend (Render):
#   NODE_ENV=production
#   FRONTEND_URL=https://farmpath.vercel.app
#   AI_SERVICE_URL=https://agrinova-ai-service.onrender.com
#   MONGODB_URI=<your production MongoDB connection string>
#   JWT_SECRET=<your unique production secret>
#   JWT_EXPIRE=30d
#
# Also configure the Cloudinary values if production image uploads use
# Cloudinary. Add any other integration credentials only when those services
# are actually configured.
#
# Do not use local URLs in production. Do not commit production credentials.
